# ── Google APIs (Search Console + Analytics 4 + Docs) ───────────────────────
# One service account, shared across all client sites. Add this service
# account's email as a read-only user on each client's GSC property, GA4
# property, and Google Doc (Share -> Viewer).
GOOGLE_SERVICE_ACCOUNT_EMAIL=seo-reports@your-project.iam.gserviceaccount.com
# Paste the private key from the downloaded JSON key file, keeping \n escapes.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Rank tracking (pick one; default is free GSC-based tracking, no key needed) ─
# SEMrush Analytics API key (semrush.com -> Profile -> API). Set
# rankSource: "semrush" on a site in sites.json to use this for that site.
SEMRUSH_API_KEY=

# DataForSEO (alternative live SERP checker) -- https://app.dataforseo.com
# Set rankSource: "dataforseo" on a site in sites.json to use this instead.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── LLM citation checks ───────────────────────────────────────────────────────
# Used to ask ChatGPT/Perplexity/Gemini-style questions and check whether the
# client's domain or brand is cited in the answer.
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GOOGLE_AI_API_KEY=

# ── Outbound email (report delivery) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
REPORT_FROM_NAME="Your Agency Reports"
REPORT_FROM_EMAIL=

# Comma-separated fallback recipient if a site doesn't define its own
DEFAULT_REPORT_TO=
